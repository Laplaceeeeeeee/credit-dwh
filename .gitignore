# ============================================================
# 数据（绝不入库）
# ------------------------------------------------------------
# ⚠️ 2026-09-15 修正：原规则只排除了 data/raw 与 data/processed，
#    漏掉了新增的 data/clean/（里面是 338 MB 的 Parquet）。
#    data/raw 约 374 MB、data/clean 约 366 MB，一旦误提交，
#    仓库会直接膨胀到不可用，且几乎无法回退。
#
#    原则：data 下的**体积型产物一律不入库**，
#    只保留"生成方式"（脚本）与"元信息"（小文件）。
# ============================================================
data/raw/
data/processed/
data/clean/*.parquet
data/clean/*.tsv
data/clean/*.csv.gz
data/clean/_exp_*/

# 干净数据的元信息与页脚留证体积很小，**允许入库**（它们是可复现的凭证）
!data/clean/clean_meta.json
!data/clean/footer_line.txt
!data/clean/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

# 建库初始化脚本允许入库
!data/mysql_init/
!data/mysql_init/*.sql

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# ============================================================
# 日志与临时文件
# ============================================================
*.log
06_ops/logs/
*.tmp
*.temp
.DS_Store
Thumbs.db

# ============================================================
# 本地配置（可能含密码）
# ============================================================
.env
config.local.py
*.local.yml

# ============================================================
# 编辑器 / IDE
# ============================================================
.idea/
.vscode/
*.swp

# ===== 阶段三：大数据层体积型产物（绝不入库）=====
07_bigdata/exchange/
07_bigdata/warehouse/
07_bigdata/derby/
07_bigdata/jars/
08_benchmark/_exp/
08_benchmark/_spark_events/
09_realtime/*.csv
*.tsv
