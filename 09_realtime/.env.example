# ============================================================
# 阶段四 · 实时链路（M1：CDC -> Kafka -> Flink -> Paimon）
#
# ⚠️ 本文件入库，`.env` 不入库（.gitignore）。改版本只改 .env。
# ⚠️ 网络 credit-dwh-net 必须**先存在**（compose 里声明为 external），
#    创建方式见 09_realtime/init_network.ps1 —— 它同时把阶段二的
#    credit-dwh-mysql 接进同一个网络，Flink 才能按容器名连到 CDC 源。
# ============================================================

# 版本矩阵于 2026-09-24 锁定，见 09_realtime/技术决策.md：
#   Flink 1.20.5 线（不是最新：Flink 2.3.0 无对应 Paimon 制品）
FLINK_IMAGE=flink:1.20.5-scala_2.12-java17
KAFKA_IMAGE=apache/kafka:4.3.1

# KRaft 单节点集群 ID（固定值，便于重建时保持一致；改了等于换集群）
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# 共享网络名（阶段二 MySQL 也在里面）
SHARED_NETWORK=credit-dwh-net

# M4：第二个查询引擎（Spark，**只读**湖仓，用于证明读算分离与多引擎直读）
# 用阶段三已拉过的镜像，不新增下载。它由 profile "query" 隔离，默认不启动。
SPARK_IMAGE=apache/spark:3.5.9-scala2.12-java11-python3-ubuntu

# CDC 源库连接（阶段二容器）
MYSQL_HOST=credit-dwh-mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123456
MYSQL_DATABASE=credit_dwh
